# Zoho SMTP

# For Zoho paid organization/domain-based email:
SMTP_HOST=smtppro.zoho.com

# Alternative for personal/free Zoho accounts:
# SMTP_HOST=smtp.zoho.com

SMTP_PORT=465
SMTP_SECURITY=ssl

SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=your-zoho-password-or-app-password

SMTP_FROM_EMAIL=your-email@yourdomain.com
SMTP_FROM_NAME=Automated Sales Report

FRONTEND_URL=https://data-automation-reports.vercel.app

# Email sending on the public API. Keep "false" to only generate PDFs.
# When "true", reports can only be sent to an email confirmed with a 6-digit code.
ENABLE_EMAIL=false

# Random secret (16+ chars) used to sign verification tokens. Required when ENABLE_EMAIL=true.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VERIFY_SECRET=

# Optional limits (defaults shown)
# MAX_UPLOAD_MB=5
# MAX_CODES_PER_DAY=100
# MAX_REPORT_EMAILS_PER_DAY=100
